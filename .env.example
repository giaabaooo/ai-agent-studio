# ==============================================================
# AFFILIATE AI STUDIO - CONFIGURATION TEMPLATE (.env.example)
# ==============================================================

# Database Connection (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres@localhost:5433/affiliate_ai_studio"

# Application Mode & Cost Enforcement
APP_MODE="local"
FREE_ONLY="true"

# Google Gemini API Configuration (Gemini 3.8 Flash)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Security & Encryption
SESSION_SECRET="replace-with-a-secure-32-byte-hex-string"
TOKEN_ENCRYPTION_KEY="replace-with-a-secure-32-byte-hex-string"

# TikTok Official API Credentials (Optional in Phase 1 & 2)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/tiktok/callback"

# Media Storage & Portability
MEDIA_ROOT="./media"
MACHINE_LABEL="MAC_OFFICE"
FFMPEG_PATH="/Users/na/.local/bin/ffmpeg"

# Voice Configuration
VOICE_PROVIDER="MACOS_SAY" # "MACOS_SAY" | "EDGE_TTS"
